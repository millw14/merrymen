{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // THE WEB ALIAS, so `tsx --test` can load a web module that uses it.
      //
      // `web/tsconfig.json` has had `@/*` since the beginning, but the runner
      // resolves against THIS file, so any web source importing `@/…` at
      // runtime was untestable — it failed at import with "Cannot find module".
      // Type-only `@/` imports were fine, which is why nothing noticed until a
      // terminal module needed a value from web/src/lib.
      "@/*": ["web/src/*"],
      "@merrymen/core": ["packages/core/src/index.ts"],
      // Reached from web/src/lib/recover-client.ts, which RecoverPanel imports.
      // Same reason as `@/*` above: without it the panel cannot be imported by
      // a test at all, and the recovery flow is the one place where "it renders
      // but does nothing" costs somebody their money.
      "@merrymen/recover": ["worker/src/recover.ts"],
      "@merrymen/thesis": ["worker/src/thesis-policy.ts"],
      "@merrymen/identity-store": ["worker/src/identity-store.ts"]
    }
  },
  "include": ["worker/src", "packages/core/src"]
}
