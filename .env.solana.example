# Server-only Solana configuration. Copy to .env.solana.local (gitignored, mode 0600).
# Placeholders only: never commit a real key, URL with a key, seed or hash here.
# Do not put credentials in NEXT_PUBLIC_ variables or Robinhood RPC settings.
# The local npm commands (check:solana-rpc, solana:paper, start:solana, solana:hold,
# solana:resolve) load this file; solana:recover deliberately does not. Hosted
# services get these values from their secret environments, never from this file.
# Every setting is described in docs/solana-integration.md ("Configuration").

# ── Solana switch ───────────────────────────────────────────────────────────
# WEB AND SOLANA WORKER. 1 turns on the Solana network switch, the /solana
# screen, every /api/solana route and Privy's Solana wallets, and lets the Solana
# worker (start:solana, merrymen solana-agent) start: without it the worker
# refuses (exit 78) before it opens any storage. Unset (the default, and the
# production setting until the release gates are signed off) the web answers
# 404 before sign-in, body parsing or any database read. Each service reads its
# own copy. To stop Solana during an incident, hold trading first
# (npm run solana:hold -- set all), never by unsetting the web's copy alone:
# that also removes owners' in-app revoke and withdraw. Operator CLIs
# (solana:hold, solana:resolve) and solana:recover run without it.
MERRYMEN_SOLANA=1
# WEB BUILD ARG, not a runtime variable (Next inlines it at build time; a change
# needs a rebuild). Exactly 1 shows the "Back up your owner key" card; anything
# else, unset included, hides it. Keep it off until wallet export is enabled for
# the Privy app AND the deployed vault is listed in SOLANA_VAULT_RELEASES in the
# published CLI. Public by design, never a secret.
# NEXT_PUBLIC_MERRYMEN_SOLANA_OWNER_KEY_EXPORT=
# Existing web setting. Production must set it; when unset, a page opened at
# http://127.0.0.1:<port> is accepted as same-origin for /api/solana (local use).
# MERRYMEN_PUBLIC_ORIGIN=https://YOUR_PUBLIC_WEB_ORIGIN

# ── RPC and quotes (web and worker) ─────────────────────────────────────────
# HTTPS, no user info or fragment. Every session checks the mainnet-beta genesis
# hash. Required for paper and live.
MERRYMEN_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=REPLACE_WITH_YOUR_KEY
# REQUIRED FOR LIVE (paper may leave it unset): an independent mainnet provider on
# a different hostname (case and a trailing dot are ignored when comparing), and
# in practice a different company: hostnames are the only independence check.
# Both providers must answer every live trade's balance, vault and Pyth reads and
# its pre-sign simulation at the prepared slot; fills, failures, expiries, owner
# transactions, inflows and the vault deployment are booked only when both agree.
# MERRYMEN_SOLANA_RPC_MAINNET_FALLBACK=https://YOUR_SECOND_PROVIDER/REPLACE_WITH_YOUR_KEY
# Trimmed, then 1 to 1024 printable ASCII characters with no spaces. Unset or
# empty: quotes are not configured (a status blocker). Set but unusable: a status
# blocker for trades and exits plus an [alert] line.
MERRYMEN_JUPITER_API_KEY=REPLACE_WITH_YOUR_KEY

# ── Storage ─────────────────────────────────────────────────────────────────
# Shared app/worker storage. Required in hosted mode; the local default is
# MERRYMEN_HOME/solana-accounts.sqlite (separate from the local paper CLI book).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Live deployment (leave unset until a reviewed immutable deployment exists) ──
# The program ID declared in contracts/solana is the LOCAL TEST identity
# EUzYVniKtgNNgFweMtRA9vciTWtE8MDTRfh6ai6VvXoU; live refuses it.
# MERRYMEN_SOLANA_VAULT_PROGRAM: the deployed program's public key. Its binary must
# declare this id (declare_id!), have no upgrade authority, and hash to
# MERRYMEN_SOLANA_VAULT_SHA256 on both providers.
# MERRYMEN_SOLANA_VAULT_SHA256: 64 lowercase hex characters, the SHA-256 of the
# ProgramData account's bytes after its 45-byte header, padding included. Take it
# from the committed contracts/solana/build-manifests/Linux-x86_64.json artifact.sha256
# (equal to the release record's sha256 of a CI run on main) ONLY when the
# deployment's max-len equals the artifact's byte count; otherwise hash the
# artifact followed by (max-len - bytes) zero bytes. Never from a laptop build or
# Darwin-arm64.json. Once SOLANA_VAULT_RELEASES (packages/core/src/solana-live.ts)
# lists a release, the pair must be exactly one listed pair or every live trade
# and in-app owner action is refused as configuration.
# MERRYMEN_SOLANA_VAULT_PROGRAM=REPLACE_WITH_VERIFIED_PROGRAM_PUBLIC_KEY
# MERRYMEN_SOLANA_VAULT_SHA256=REPLACE_WITH_VERIFIED_64_CHARACTER_LOWERCASE_SHA256

# LIVE ONLY: each is canonical base64 for exactly 32 bytes, supplied privately.
# Preserve the DEK to decrypt existing sessions; share it across app and worker.
# The fee payer must be separate from every owner and session and is a plain
# system account. Never configure an owner key: there is no such setting.
# MERRYMEN_STORE_DEK=REPLACE_WITH_PRIVATE_BASE64_32_BYTE_ENCRYPTION_KEY
# MERRYMEN_SOLANA_FEE_PAYER_SEED=REPLACE_WITH_PRIVATE_BASE64_32_BYTE_FEE_PAYER_SEED

# ── Fees (web and worker; give both the same values) ────────────────────────
# Hard cap per live trade on network fee plus temporary-account rent, in
# lamports. Default 5000000. A whole number above zero; anything else is a
# configuration blocker that refuses live trades and exits.
# MERRYMEN_SOLANA_MAX_FEE_LAMPORTS=5000000
# MINIMUM swap compute-unit price, micro-lamports per unit. Default 0. The
# executor follows the 75th percentile of recent fees above it. A non-zero
# minimum is paid even when the fee payer is low and is not in the status
# fee-payer floor, so keep it 0 or small.
# MERRYMEN_SOLANA_COMPUTE_UNIT_PRICE_MICROLAMPORTS=0
# MAXIMUM swap compute-unit price. Default: the larger of 1000000 and the
# minimum (about 0.00024 SOL on a 240k-unit swap). Below the minimum, or not a
# whole number: a full status blocker that refuses trades and exits.
# MERRYMEN_SOLANA_MAX_COMPUTE_UNIT_PRICE_MICROLAMPORTS=1000000
# Warning watermark for the shared fee payer, lamports. Default 4 x
# MERRYMEN_SOLANA_MAX_FEE_LAMPORTS (20000000 = 0.02 SOL). Below it: a status
# warning and an [alert]; trading continues. A malformed value is only a warning
# plus an [alert]; the default is used. The hard levels below which buys, then
# exits, stop (one temporary token account's rent plus two signatures, about
# 0.002 SOL) come from the chain and are not settings.
# MERRYMEN_SOLANA_FEE_PAYER_LOW_LAMPORTS=20000000

# ── Independent SOL price (web and worker; give both the same values) ───────
# How far (bps) a live trade's guaranteed output may sit below the Pyth SOL/USD
# reference. Whole number 50-1000, unset or empty is 300. Anything else refuses
# every live trade, exits included, and pages an [alert]. Admission and the
# executor refuse a bound built with any other tolerance.
# MERRYMEN_SOLANA_REFERENCE_TOLERANCE_BPS=300
# Pyth SOL/USD reference generation: current (the default; unset or empty also
# means current; account 7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE) or
# upgraded (Pyth's 2026-08-26 programs; account
# 7AviUf9nL62mcxNbQGKm4nKDQnPjswo6c5MX4D57HmyE). Exact lowercase; any other value
# refuses all live trading, exits included, and registering a live permission
# (which reads the price to check the SOL sold per trade is worth at least the
# 1 USDG live minimum). Never falls back to the other one.
# MERRYMEN_SOLANA_PYTH_GENERATION=current

# ── Daily operations (web and worker; give both the same value) ─────────────
# Proven-expired attempts a rolling day that do NOT count toward the owner's
# maxOpsPerDay. Whole number 0-96 written without leading zeros, default 0
# (every signed transaction counts). 96 is the most permissive value, not the
# old rule. Anything else refuses live trading and exits as configuration.
# MERRYMEN_SOLANA_EXPIRED_ATTEMPT_ALLOWANCE=0

# ── Live rollout (web and worker; give both the same values) ────────────────
# Like Robinhood's MERRYMEN_FLEET_ROLLOUT: which tenants may go live, and caps on
# the live limits they may sign. The list only ever stops NEW live permissions
# and BUYS: exits (sales back to USDG), revoke, withdrawals, recording
# withdrawals made outside Merrymen and paper never read it (status reads it, to
# report it and to say the [alert] when it cannot be read). The caps bound the
# limits a new permission may sign, and through those limits they bound sales
# too: the vault program charges a sale's USDG proceeds to the same per-trade
# and daily USDG limits as a buy, and its SOL to the SOL sold limits, so at the
# defaults a sale is at most 10 USDG and 0.1 SOL. Buys therefore keep room for
# exits: a buy is refused once it would leave too little of the rolling 24-hour
# limits to sell the whole SOL position within them (a day's buys stop at about
# half the USDG cap). Withdraw is never limited by any cap.
# Web and worker are compared: while their list or caps differ, every live buy
# is held on both, with "[alert] solana-live-rollout differs". Deploy every
# change to the Solana worker first, then the web: no hold is needed
# (docs/hosted-deploy.md, "Turning Solana on", step 4).
#
# Comma-separated 0x tenant ids (0x and 40 hex digits, the ids the RH rollout
# uses; spaces around entries are ignored, case does not matter). Unset or empty
# (the default): NO tenant may save live mode, register, activate or buy; paper
# is open to every bound tenant. A tenant taken off the list after going live is
# exits-only, and its status says "Live trading is paused for this account:
# exits, revoke and withdraw still work." (Once its permission has expired or
# been replaced on Solana it cannot sell either, and status says only revoke
# and withdraw work.) A malformed entry (named by position in
# the [alert], never repeated) refuses new permissions and buys for everyone.
# MERRYMEN_SOLANA_LIVE_TENANTS=0xYOUR_CANARY_TENANT_ID
# Platform caps on live limits, decimal USDG or SOL (exact: at most 6 or 9
# decimal places). Unset or empty uses the default shown. Live limits above a cap
# are refused when saved, when a permission is prepared and when its signed
# bytes are submitted, so none above the caps in force is sent to Solana; a
# session registered (or sent) before a cap was lowered may not buy until the
# owner registers within the caps, and keeps its exits. A malformed value, a
# per-trade cap above its daily cap, or a USDG per-trade cap under 1 USDG refuses
# new permissions and buys for everyone, with an [alert].
# MERRYMEN_SOLANA_LIVE_MAX_PER_TRADE_USDG=10
# MERRYMEN_SOLANA_LIVE_MAX_DAILY_USDG=25
# MERRYMEN_SOLANA_LIVE_MAX_PER_TRADE_WSOL=0.1
# MERRYMEN_SOLANA_LIVE_MAX_DAILY_WSOL=0.25

# ── Dedicated hosted Solana worker service ONLY (not the web service) ───────
# MERRYMEN_START=start:solana
# MERRYMEN_SOLANA_SERVICE_ID=REPLACE_WITH_SOLANA_RAILWAY_SERVICE_ID
# MERRYMEN_FLEET_SERVICE_ID=REPLACE_WITH_DIFFERENT_RH_FLEET_SERVICE_ID
# Existing hosted authentication/image requirements still apply; see
# docs/hosted-deploy.md. This example does not deploy or enable a strategy.

# ── Operator machine only (never on the web or worker service) ──────────────
# Third provider for `npm run solana:resolve -- ... --third-rpc`: an HTTPS
# mainnet URL on a hostname different from both providers above, ideally a third
# company. Read from here or the environment, never from the command line.
# MERRYMEN_SOLANA_RESOLVE_THIRD_RPC=https://YOUR_THIRD_PROVIDER/REPLACE_WITH_YOUR_KEY

# ── Owner's own computer only (never on a server, never stored in this file) ──
# MERRYMEN_SOLANA_RECOVER_RPC is the mainnet-beta HTTPS RPC that
# `merrymen solana-recover` uses. Only that tool reads it, and npm run
# solana:recover does not load this file. Set it without typing the URL into a
# command (the URL may carry an API key): `read -rs MERRYMEN_SOLANA_RECOVER_RPC;
# export MERRYMEN_SOLANA_RECOVER_RPC`, paste, Enter. --rpc is only for a keyless
# URL; giving both is refused.

# ── Read by code but not configuration: do not set these here ───────────────
# MERRYMEN_SOLANA_WORKER_IPC: set by `merrymen solana-agent` for the worker it
#   spawns; any other value makes the worker refuse to start.
# MERRYMEN_JUPITER_FORK_PROGRAMS: test-only, for contracts/solana/test.sh's
#   Jupiter fork test (contracts/solana/README.md).
# MERRYMEN_WRITE_SOLANA_ABI_FIXTURE, MERRYMEN_WRITE_SOLANA_RECOVERY_FIXTURE,
#   MERRYMEN_SOLANA_CRASH_DB, MERRYMEN_SOLANA_CRASH_CHILD: test harness only.
