# WHY THIS FILE EXISTS: ONE OPTIONAL PEER WE DELIBERATELY DO NOT INSTALL.
#
# `@privy-io/react-auth` declares `permissionless` as a peerOptional — it is the
# dependency of Privy's SMART WALLET feature, which merrymen must never enable:
# we already have Kernel v3.3, ERC-4337, the permission wall and existing
# smart-account addresses, and a second smart-account implementation beside them
# is exactly the thing the integration was scoped to avoid.
#
# npm still resolves that optional peer's own peers, and `permissionless` wants
# `ox@^0.8`, while viem 2.55 (which @zerodev/* pins) brings `ox@0.14`. So the
# install fails on a conflict between two packages neither of which we use.
#
# legacy-peer-deps skips that resolution. The check that it did the right thing
# is not this comment — it is `node_modules/permissionless` being ABSENT, which
# web/src/lib/privy-boundary.test.ts asserts along with the rest of the
# smart-wallet and server-delegation surface.
legacy-peer-deps=true
