<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the colours; this exists so the window has a sane
         background before the first frame and does not flash white on a dark
         device. On Android 12+ the system draws its own splash from the launcher
         icon over this background, using the current Merrymen pill mark. -->
    <style name="Theme.Merrymen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
