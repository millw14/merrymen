# Merrymen AI gateway — copy to .env and fill in. These are SERVER-ONLY secrets;
# they never reach the merrymen client.

# The REAL upstream key (e.g. a Groq key from console.groq.com/keys). Server-only.
MERRYMEN_GATEWAY_UPSTREAM_KEY=

# HMAC secret that signs holder access tokens. Use 32+ random bytes, keep it stable
# (rotating it invalidates every issued token and every partner key, whose
# stored hash it peppers, and signs every developer out of the portal).
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MERRYMEN_GATEWAY_SECRET=

# Robinhood Chain (4663) RPC — used read-only for balanceOf to verify holdings.
MERRYMEN_GATEWAY_RPC=

# --- optional (sensible defaults) ---
# The domain shown in the message holders sign (context + phishing resistance).
# Defaults to merrymen.dev; set it to the host you actually serve the gateway on.
# MERRYMEN_GATEWAY_DOMAIN=ai.merrymen.dev
# Upstream OpenAI-compatible chat endpoint (default: Groq).
# MERRYMEN_GATEWAY_UPSTREAM=https://api.groq.com/openai/v1/chat/completions
# The model the gateway forces server-side (the client never picks it).
# MERRYMEN_GATEWAY_MODEL=qwen/qwen3.8-27b
# Whole $MERRYMEN a wallet must hold to qualify (default 10000 = Villager tier).
# MERRYMEN_GATEWAY_MIN_TOKENS=10000
# Port (default 8787).
# PORT=8787

# --- shared state (KV): required on Vercel, optional for one process ---
# On Vercel the nonce/rate-limit/balance state must live in a shared KV store
# (isolates don't share memory). Add Upstash Redis / Vercel KV from the dashboard;
# it injects these automatically — you don't set them by hand:
#   KV_REST_API_URL=...        (or UPSTASH_REDIS_REST_URL)
#   KV_REST_API_TOKEN=...      (or UPSTASH_REDIS_REST_TOKEN)
# A single long-running process (Railway, Docker) works without them, in
# memory, but then every restart or deploy signs developers out of the portal
# (see MERRYMEN_DEVELOPER_PORTAL_SECRET below). Set them there by hand to keep
# sessions; any instance uses KV once both are set.

# --- discovery (optional) ---
# Your Bitquery key. Setting it turns on POST /bitquery for verified holders,
# so nobody else needs a Bitquery account. Leave it blank and that route
# returns 503 while everything else works exactly as before.
#
# COST NOTE, because this one is YOUR bill: Bitquery charges per query, and the
# gateway will not proxy arbitrary GraphQL for exactly that reason — it answers
# only the named queries in lib/core.mjs (BITQUERY_QUERIES) and builds the
# GraphQL itself, clamping every variable. Adding a capability is a deliberate
# edit there, never something a client can ask for. Discovery also gets its own
# rate bucket (BITQUERY_RATE_PER_MIN, 6/min/wallet) so a polled feed can't eat
# the allowance the holder's brain shares.
# MERRYMEN_GATEWAY_BITQUERY_KEY=

# ── partner API (/partner/v1) ────────────────────────────────────────────────
#
# A SECOND credential system, for businesses building on merrymen — separate
# from the mmk_ holder tokens above and rejecting them, in both directions
# (partner-cross.test.mjs pins that). Partner keys are `mmp_<keyId>_<secret>`,
# scoped and revocable, and the registry stores only an HMAC of the secret.
#
# Developers mint their own keys at merrymen.dev/api, which calls this
# gateway's /developer/v1 routes (see MERRYMEN_DEVELOPER_PORTAL_SECRET below),
# once they have created a developer account there (with partner billing on,
# below): read:agents, write:agents and chat:agents, five active keys per
# wallet, and 30 requests a minute per key (under billing enforce: the
# account's plan rate, shared by all its keys). Each caller IP also gets 600 a
# minute. Operators issue anything else
# with the local CLI; their keys have no owner and are never metered:
#
#   node partners-cli.mjs issue --name prism --app-id prism-production --scopes read:agents,write:agents,chat:agents
#   node partners-cli.mjs revoke <keyId>
#   node partners-cli.mjs list
#
# The key is printed once. Only its hash is written down, so a lost key is
# re-issued, never recovered. Reuse the SAME --app-id when rotating a key so
# the replacement can access that application's existing connections. Portal
# keys are written to the same registry.
#
# WHERE THE REGISTRY LIVES. By default the append-only JSONL at
# $MERRYMEN_DATA_DIR/partners.jsonl (the same volume as the iOS list). This env
# var is the zero-infrastructure alternative for a box with no volume — a JSON
# array of the same records. The FILE WINS for any key id it mentions, so a
# revocation written to the volume can always override a stale value here.
# MERRYMEN_PARTNER_KEYS=[{"keyId":"…","appId":"prism-production","name":"prism","hash":"…","scopes":["read:agents","write:agents","chat:agents"],"status":"active"}]

# --- partner agent runtime bridge ---
# A dedicated secret of at least 32 bytes, set to the SAME value on this gateway
# and the hosted web service. It authenticates internal forwarded requests and
# enrollment challenges. Generate independently from the gateway/session secrets;
# never share it with partner applications or put it in a public/NEXT_PUBLIC var.
MERRYMEN_PARTNER_BRIDGE_SECRET=

# Hosted web origin receiving authenticated /api/partner requests. HTTPS required
# except localhost development. Defaults to the production app origin below.
# MERRYMEN_PARTNER_APP_ORIGIN=https://app.merrymen.dev

# The gateway logs at boot if this or the portal secret below is unset or too
# short; until it is set, partner agent routes answer 503 upstream_unavailable.
# Each failed bridge call is logged as "[gateway] partner bridge: METHOD /route
# req_... key <keyId> ..." with what came back; the req_ id is the request_id
# the partner was given. docs/hosted-deploy.md §5c says what each ending means.

# Shared only with the merrymen.dev server for wallet-authenticated key management.
# Use a separate random secret of at least 32 bytes, set to the SAME value on the
# site. Never expose as NEXT_PUBLIC. Unset or shorter, /developer/v1 answers 503.
#
# It authenticates the portal, and a hash of it is mixed into the developer
# session key; it cannot sign anyone in on its own. Developer sign-in challenges
# and sessions are signed with a key derived from MERRYMEN_GATEWAY_SECRET, so the
# site's environment cannot mint a session for a wallet. Sign-in accepts only an
# ordinary wallet's (EOA) signature, checked here with no RPC call, so no chain
# endpoint can vouch for one; MERRYMEN_GATEWAY_RPC is not used for it. Sessions
# last up to eight hours, and the site's logout asks this gateway to revoke them
# (best effort: if that call fails, the session lives out its eight hours).
# Consequences:
#   - rotating MERRYMEN_GATEWAY_SECRET signs every developer out (and voids
#     every partner key);
#   - rotating this portal secret, on the gateway and the site together, also
#     signs every developer out and leaves partner keys working: the switch to
#     use for a leaked session cookie. It ends sessions but not what one did:
#     afterwards list the affected developer's keys (`node partners-cli.mjs list`),
#     revoke any minted while the cookie was exposed, and reissue any it revoked;
#   - on the in-memory store (no KV_REST_API_* above), a restart or deploy also
#     signs every developer out, because logouts live in that store and must not
#     be forgotten while their sessions survive. With KV, sessions and logouts
#     both survive deploys, and a KV outage answers 503 rather than guess.
# The site may point its proxy elsewhere with MERRYMEN_DEVELOPER_GATEWAY_ORIGIN
# (its own env, server-only: an https origin, or http on localhost).
MERRYMEN_DEVELOPER_PORTAL_SECRET=

# ── partner billing (MERRYMEN-paid plans) ────────────────────────────────────
#
# A developer creates an account at merrymen.dev/api, chooses a plan (the table
# is lib/billing-plans.mjs: Free, then paid tiers per 30 days) and pays by
# sending $MERRYMEN FROM THE WALLET THEY SIGNED IN WITH to the treasury below.
# This gateway only READS the chain to verify that transfer: it never sends a
# transaction and holds no key. Every partner request made with a portal key
# counts against its account's plan; /meta, /health and discovery are free, a
# request the platform failed (5xx, upstream_*, a busy runtime) gives its unit
# back, and operator keys are never metered.
#
# OFF unless every requirement below holds. Each reason it is not on is a
# "[billing]" line at boot, then "[gateway] partner billing: <mode>" (on stderr
# when that is not what was asked for, or payments are unavailable).
#   off      the default: partner requests are neither metered nor refused for
#            quota, every key keeps its own per-key rate, and a developer
#            mints keys without an account, as before billing. Developers can
#            already create accounts and read GET /developer/v1/plans; plans
#            and payments answer 503 billing_off. (The partner per-IP limit is
#            600 a minute in every mode, up from 240.)
#   observe  accounts, plans, payments and metering all work, and the quota
#            headers and /meta's billing object show usage, but no quota is
#            refused, and each key keeps its own per-minute bucket at its own
#            rate (or its plan's, when higher): nothing billing off answered
#            is refused. Run this first: a full 30-day window shows who
#            enforce would refuse; comp existing partners with the CLI below
#            if needed (it refuses a comp while a paid period is running).
#   enforce  a spent quota answers 402 quota_exhausted, and an account's keys
#            share ONE per-minute bucket at its plan's rate (Free: 30 a minute
#            for all of a developer's keys together). Needs the treasury AND
#            the start block below, or it runs observe.
# MERRYMEN_BILLING=off
#
# DURABILITY GATE: billing stays off unless MERRYMEN_DATA_DIR is set EXPLICITLY
# (not left to the /data default) to a writable, persistent volume. Its
# billing.jsonl is the only record of who paid: on a disk a deploy wipes, every
# past transfer becomes creditable again. Back it up with the volume. ONE
# INSTANCE ONLY, never replicas and never a host without a persistent disk:
# two processes on one ledger would each credit the same transfer. The same
# directory holds partners.jsonl and usage.json (request counts, saved every
# 10 s and on SIGTERM/SIGINT; a crash loses at most ~10 s of counts, which
# favours the developer). On SIGTERM, requests in flight get up to 3 s to
# finish, then the counts are saved and the process exits within 10 s: give
# it that long before SIGKILL (on Railway, RAILWAY_DEPLOYMENT_DRAINING_SECONDS
# of 12 or more), or a deploy loses what a crash would.
# MERRYMEN_DATA_DIR=/data
#
# The wallet payments go to. A NEW address used for API billing and nothing
# else: any $MERRYMEN transfer to it from a signed-in wallet, at or after the
# start block, can be credited to that wallet's account. The gateway never
# needs its key, so a multisig or cold wallet is fine. Not the zero address or
# the token contract (either is ignored). Unset: payments answer 503
# payments_unavailable and GET /developer/v1/plans shows treasury: null.
# MERRYMEN_PAYMENTS_TREASURY=
#
# Required with a treasury (without it, the treasury is ignored): transfers in
# earlier blocks are never credited, so nothing that reached the address before
# billing opened can be claimed. Use the chain's current block when you first
# set the treasury.
# MERRYMEN_PAYMENTS_START_BLOCK=
#
# ROTATION: after changing the treasury, keep the old one here for a while so a
# transfer sent from a page that still showed it is credited. Comma-separated.
# Each payment records the address it paid, and every change to the treasury,
# this list or the start block is appended to the ledger and logged at boot.
# MERRYMEN_PAYMENTS_PREVIOUS_TREASURIES=
#
# The RPC payment checks read: receipt, latest block, the receipt's block.
# Defaults to MERRYMEN_GATEWAY_RPC; its own client, with no retries and no
# cache. It must answer chain 4663, checked at boot and before every credit,
# or payments are unavailable. It is TRUSTED to report receipts: one that lies
# can give away API usage, never move anyone's tokens. Never logged (its URL
# may carry a key). Developer sign-in never consults it.
# MERRYMEN_PAYMENTS_RPC=
#
# A transfer is credited once it is BOTH this many blocks deep and this many
# seconds old; until then the portal shows it confirming. Robinhood Chain makes
# about ten blocks a second, and 64 is the depth the worker books at. Credits
# from the last 30 minutes are re-checked every 5 minutes, and one a reorg
# undid is reversed.
# MERRYMEN_PAYMENTS_MIN_CONFIRMATIONS=64
# MERRYMEN_PAYMENTS_MIN_AGE_SEC=120
#
# Operators read accounts, correct credit and comp plans on the gateway's own
# volume (`railway ssh`), with this environment; the running gateway picks the
# change up within 10 s:
#   node billing-cli.mjs list
#   node billing-cli.mjs show <wallet>
#   node billing-cli.mjs adjust <wallet> <±tokens> --note "why"
#   node billing-cli.mjs comp <wallet> <tier> <days> --note "why"
#   node billing-cli.mjs reconcile [--all]      (a dry run; writes nothing)
